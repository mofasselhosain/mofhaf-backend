model ProductImage {
  id        String   @id @default(ulid())
  url       String
  publicId  String?
  alt       String?
  isPrimary Boolean  @default(false)
  position  Int      @default(0)

  productId String
  product   Product  @relation(fields: [productId],references: [id],onDelete: Cascade )

  @@index([productId, position])
}